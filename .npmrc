# typescript ~6.0.2 (project) conflicts with openapi-typescript@7's peer range
# (^5.x, tightened further to <6.1.0 by @typescript-eslint) — a plain `npm ci`
# ERESOLVEs on a clean install. The working node_modules already relies on
# this flag; recording it here makes that reproducible (Docker, CI, other
# machines) instead of an invisible, undocumented local state.
legacy-peer-deps=true
